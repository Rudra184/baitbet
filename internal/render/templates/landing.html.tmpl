<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<style>
  body { margin: 0; font-family: -apple-system, Segoe UI, Arial, sans-serif; background: {{.BrandColor}}; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
  .card { width: 360px; background: #ffffff; border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.18); padding: 32px; }
  img.logo { height: 32px; margin-bottom: 16px; }
  h1 { font-size: 18px; margin: 0 0 20px; color: #1a1a1a; }
  label { display: block; font-size: 13px; color: #4a5563; margin: 14px 0 4px; }
  input { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #d7dde3; border-radius: 4px; font-size: 14px; }
  button { width: 100%; margin-top: 20px; padding: 10px 12px; background: #0b1f3a; color: #fff; border: none; border-radius: 4px; font-size: 14px; cursor: pointer; }
</style>
</head>
<body>
  <div class="card">
    {{if .LogoDataURI}}<img class="logo" src="{{.LogoDataURI}}" alt="">{{end}}
    <h1>{{.Title}}</h1>
    {{template "form" .}}
  </div>
</body>
</html>
